# Local web: use the deployed API URL in Vercel's project environment.
VITE_API_URL=http://localhost:4000/api

# Local mobile: for a physical phone, use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# API local development only. Render generates a production value.
JWT_SECRET=replace-with-a-long-random-secret

# Atlas connection string; set privately in Render, never commit a real value.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/healthylife?retryWrites=true&w=majority
MONGODB_DATABASE=healthylife

# Comma-separated frontend origins, for example https://healthylife.vercel.app
CORS_ORIGINS=http://localhost:5173
